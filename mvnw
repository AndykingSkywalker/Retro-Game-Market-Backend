#!/bin/sh
# Apache Maven Wrapper
#
# Licensed to the Apache Software Foundation (ASF) under one
# or more contributor license agreements.
#
# This is a minimal bootstrap script that downloads the Maven Wrapper JAR
# and runs it. Generated by tooling; safe to commit.

MVNW_REPOURL="https://repo.maven.apache.org/maven2"

BASEDIR=$(cd "$(dirname "$0")" && pwd)
WRAPPER_DIR="$BASEDIR/.mvn/wrapper"
JAR="$WRAPPER_DIR/maven-wrapper.jar"

if [ ! -f "$JAR" ]; then
  echo "Downloading Maven wrapper..." >&2
  mkdir -p "$WRAPPER_DIR" || exit 1
  WRAPPER_VERSION="3.3.2"
  URL="$MVNW_REPOURL/org/apache/maven/wrapper/maven-wrapper/$WRAPPER_VERSION/maven-wrapper-$WRAPPER_VERSION.jar"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$URL" -o "$JAR" || exit 1
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$URL" -O "$JAR" || exit 1
  else
    echo "Neither curl nor wget is available to download Maven Wrapper" >&2
    exit 1
  fi
fi

JAVA_CMD="java"
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
fi

exec "$JAVA_CMD" -Dmaven.multiModuleProjectDirectory="$BASEDIR" -classpath "$JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
